#!/usr/bin/env bash
# bin/trinity — Trinity シェルハーネス唯一の実行ファイル。
#
# サブコマンド:
#   loop <RUN_DIR> <WORKTREE_DIR> <BRANCH>
#       Plan → Generate → 道具 → Evaluate を最大 TRINITY_MAX_LOOPS 回（既定 5）反復する。
#       起動時に RUN_DIR/.pid.lock を排他ロックとして確保し、その中の pid ファイルの生存
#       （pid 再利用誤検知を避けるため argv の RUN_DIR 一致まで）を確認する。生存していれば
#       二重起動として中止する。生きていなければロックを奪い自身の PID を書いて継続する
#       （クラッシュ再開）。確認が要るときは RUN_DIR/ask/q を書いて needs-input でブロックする。
#       再起動時は RUN_DIR の既存成果物から中断点を判定して再開する。RUN_DIR/redrive があれば
#       修正要望を requirement.md へ一度きり取り込み、その開始ループを RUN_DIR/redrive-start に
#       固定したうえで、そこから TRINITY_MAX_LOOPS 回ぶんの予算で再収束する（この起点はクラッシュ
#       後の再開でも読み直され動かない）。redrive・redrive-start・ロックは、再収束が新しい PASS
#       に達するか failed／error の終端に達したときに削除する（それまでは再開のたびに読み直される
#       耐久状態として残る）。

set -euo pipefail

TRINITY_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export TRINITY_ROOT

[ "${1:-}" = loop ] || {
  printf '使い方:\n  trinity loop <RUN_DIR> <WORKTREE_DIR> <BRANCH>\n' >&2
  exit 1
}
shift

# --- loop — 1 Issue の収束ループ -------------------------------------------
loop_main() {
  local RUN_DIR WORKTREE_DIR BRANCH
  RUN_DIR="${1:?usage: trinity loop <RUN_DIR> <WORKTREE_DIR> <BRANCH>}"
  WORKTREE_DIR="${2:?WORKTREE_DIR required}"
  BRANCH="${3:?BRANCH required}"
  export RUN_DIR WORKTREE_DIR BRANCH

  mkdir -p "${RUN_DIR}/ask"
  # shellcheck source=lib/actors.sh
  . "${TRINITY_ROOT}/lib/actors.sh"

  # 起動の原子性: pid ファイルの read-then-write では二重起動の窓を閉じられないため、
  # ファイルシステムレベルで atomic な mkdir を排他ロックに使う。ロック用ディレクトリ自身に
  # pid を記録することで、排他制御と生存記録を単一の実体にまとめる。生存中の pid（かつ argv に
  # 自分の RUN_DIR を含む——pid 再利用による誤検知を避ける）があれば同一 worktree への
  # 二重起動として中止する。ロックが残っていても保持者が死んでいれば奪って継続する
  # （クラッシュ再開）。
  local lock_dir="${RUN_DIR}/.pid.lock"
  if ! mkdir "${lock_dir}" 2>/dev/null; then
    local old_pid=""
    [ -f "${lock_dir}/pid" ] && old_pid="$(cat "${lock_dir}/pid" 2>/dev/null || true)"
    if [ -n "${old_pid}" ] && kill -0 "${old_pid}" 2>/dev/null \
        && ps -o args= -p "${old_pid}" 2>/dev/null | grep -qF "${RUN_DIR}"; then
      trinity::log "起動中止: pid ${old_pid} が生存中のため二重起動を防ぐ"
      exit 1
    fi
    rm -rf "${lock_dir}"
    mkdir "${lock_dir}" 2>/dev/null \
      || { trinity::log "起動中止: ロック取得に失敗した（並行起動と競合）"; exit 1; }
  fi
  printf '%s\n' "$$" > "${lock_dir}/pid"

  # 終端（passed／failed／error）に達したときだけ redrive・redrive-start・ロック（pid を含む）を
  # 削除する。status を経由で判定するので、set -e によるどの終了経路（lib/actors.sh 内の
  # trinity::status error 経路を含む）でも EXIT トラップが同じ基準で回収する。
  # 非終端のまま死ぬ本当のクラッシュでは trap 自体が走らず、これらは残る
  # （Orchestrator のクラッシュ再開判定はこの残存に依存する）。
  trap '
    case "$(cat "${RUN_DIR}/status" 2>/dev/null || true)" in
      passed | failed | error)
        rm -f "${RUN_DIR}/redrive" "${RUN_DIR}/redrive-start" "${RUN_DIR}/redrive-appended"
        rm -rf "${RUN_DIR}/.pid.lock" ;;
    esac
  ' EXIT

  : "${TRINITY_MAX_LOOPS:=5}"

  # 設計分岐の確認: plan.md の `## 要確認の論点` を ask/q に出し、回答（ask/a）を待つ。
  # 人間の確認に締切は設けない（回答が来るまで安価に待つ）。
  loop::ask() {
    local loop="$1"
    awk '/^## 要確認の論点/{p=1;print;next} p&&/^## /{p=0} p' \
      "${RUN_DIR}/plan.md" > "${RUN_DIR}/ask/q"
    rm -f "${RUN_DIR}/ask/a"
    trinity::status needs-input
    trinity::log "ループ ${loop}: 確認待ち（ask/q を Orchestrator が拾う）"
    while [ ! -f "${RUN_DIR}/ask/a" ]; do sleep 5; done
    { printf '\n## 確定事項（ループ %s で確認済み）\n' "${loop}"; cat "${RUN_DIR}/ask/a"; } \
      >> "${RUN_DIR}/requirement.md"
    rm -f "${RUN_DIR}/ask/q" "${RUN_DIR}/ask/a"
  }

  # RUN_DIR の既存成果物から再開ループ番号とモードを返す。
  # 出力形式: "<n> <mode>"（例: "2 plan"）。PASS 済みのときは "PASS" のみ。
  # 各段は自己スキップするため入口判定は不要。
  # REDRIVE=1（redrive マーカーが残存）のときは、直近が旧 PASS でも短絡せず
  # 次ループを plan で再収束させる。直近が NEEDS_REVISION／FAIL のときは通常どおり
  # そのモードへ委ね、再収束途中の状態を保つ。
  # REDRIVE は本関数の local ではなく enclosing scope（loop_main）の local を
  # 動的スコープ経由で参照する。loop::ask が RUN_DIR・loop を同様に参照するのと
  # 同型の作法であり、loop_main 内でのみ呼び出す前提に依存する。
  loop::resume_point() {
    local k=0 k_verdict="" num="" verdict="" f
    for f in "${RUN_DIR}"/eval-*.md; do
      [ -f "$f" ] || continue
      num="${f##*/eval-}"
      num="${num%.md}"
      case "${num}" in *[!0-9]*) continue ;; esac
      verdict="$(trinity::verdict_of "$f")"
      case "${verdict}" in
        PASS | NEEDS_REVISION | FAIL) ;;
        *) continue ;;
      esac
      if [ "${num}" -gt "${k}" ]; then k="${num}"; k_verdict="${verdict}"; fi
    done

    if [ "${k}" -eq 0 ]; then
      printf '1 plan\n'; return
    fi
    if [ "${k_verdict}" = PASS ] && [ "${REDRIVE}" -eq 0 ]; then
      printf 'PASS\n'; return
    fi

    local n mode
    n=$((k + 1))
    case "${k_verdict}" in
      PASS | NEEDS_REVISION) mode=plan ;;
      *)                     mode=revise ;;
    esac
    printf '%s %s\n' "${n}" "${mode}"
  }

  trinity::log "loop 開始: ${BRANCH}"

  # redrive マーカーは「再収束が未完」の耐久状態であり、消費して即削除しない
  # （終端 PASS／failed／error に達したとき上記 trap が削除する）。
  # requirement.md への取り込みは一度きり: 印として RUN_DIR/redrive-appended を使う
  # （テキストの部分一致だと無関係な既存記述への偶然の一致で新しい要望を取りこぼすため、
  # 内容照合ではなく専用の印で判定する）。
  local REDRIVE=0
  if [ -f "${RUN_DIR}/redrive" ]; then
    REDRIVE=1
    if [ -f "${RUN_DIR}/redrive-appended" ]; then
      trinity::log "re-drive 信号は取り込み済み。requirement.md への再追記はしない"
    else
      { printf '\n## 修正要望（re-drive）\n'; cat "${RUN_DIR}/redrive"; } >> "${RUN_DIR}/requirement.md"
      : > "${RUN_DIR}/redrive-appended"
      trinity::log "re-drive 信号を検出した。requirement.md に追記し、最大 eval 番号 + 1 から plan で再収束する"
    fi
  fi

  local resume loop mode rc
  resume="$(loop::resume_point)"
  if [ "${resume}" = PASS ]; then
    trinity::log "再開判定: 既に PASS 済み。再実行しない。"
    trinity::status passed
    exit 0
  fi
  read -r loop mode <<< "${resume}"
  [ "${loop}" -gt 1 ] && trinity::log "再開: ループ ${loop} から ${mode} で再開する"

  # re-drive は新しい収束試行なので、開始ループから TRINITY_MAX_LOOPS 回ぶんの予算を
  # 相対的に与える（通常の crash-resume は絶対上限のまま）。この開始ループは
  # RUN_DIR/redrive-start に固定し、以後の再起動では読み直すだけで動かさない
  # （resume_point が返す loop は再起動のたびに進むため、そのつど基準にすると
  # クラッシュを繰り返すたびに予算が際限なく延びてしまう）。
  local max_loop="${TRINITY_MAX_LOOPS}" redrive_start
  if [ "${REDRIVE}" -eq 1 ]; then
    if [ -f "${RUN_DIR}/redrive-start" ]; then
      redrive_start="$(cat "${RUN_DIR}/redrive-start")"
    else
      redrive_start="${loop}"
      printf '%s\n' "${redrive_start}" > "${RUN_DIR}/redrive-start"
    fi
    max_loop=$((redrive_start + TRINITY_MAX_LOOPS - 1))
  fi

  while [ "${loop}" -le "${max_loop}" ]; do
    if [ "${mode}" = plan ]; then
      rc=0
      trinity::plan "${loop}" || rc=$?
      if [ "${rc}" -eq "${TRINITY_RC_NEEDS_INPUT}" ]; then
        loop::ask "${loop}"
        continue
      fi
      [ "${rc}" -ne 0 ] && exit 1
      trinity::generate "${loop}"
    else
      trinity::revise "${loop}"
    fi

    trinity::tools "${loop}"

    rc=0
    trinity::evaluate "${loop}" || rc=$?
    case "${rc}" in
      0) trinity::log "ループ ${loop} で PASS。PR 作成へ。"; exit 0 ;;
      2) mode=plan ;;    # NEEDS_REVISION → 再計画
      3) mode=revise ;;  # FAIL → 既存計画の範囲内で修正
      *) exit 1 ;;
    esac
    loop=$((loop + 1))
  done

  trinity::status failed
  trinity::log "ループ ${max_loop} まで回したが PASS に到達しなかった"
  exit 2
}

# --- ディスパッチ -------------------------------------------------------------
loop_main "$@"
