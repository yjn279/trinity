#!/usr/bin/env bash
# bin/trinity — Trinity シェルハーネス唯一の実行ファイル。
#
# サブコマンド:
#   loop <RUN_DIR> <WORKTREE_DIR> <BRANCH>
#       Plan → Generate → 道具 → Evaluate を最大 TRINITY_MAX_LOOPS 回（既定 5）反復する。
#       起動時に自身の PID を RUN_DIR/pid に原子的に主張する。確認が要るときは RUN_DIR/ask/q を
#       書いて needs-input でブロックする。再起動時は RUN_DIR の既存成果物から中断点を
#       判定して再開する。RUN_DIR/redrive があれば修正要望を requirement.md に一度だけ
#       取り込み、最大 eval 番号 + 1 から plan モードで、その開始ループから TRINITY_MAX_LOOPS
#       回ぶんの予算で再収束する。マーカーは新しい PASS 到達時と終端 failed 到達時にのみ
#       消し、再開を跨いでも再収束が未完なら残り続ける。

set -euo pipefail

TRINITY_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export TRINITY_ROOT

[ "${1:-}" = loop ] || {
  printf '使い方:\n  trinity loop <RUN_DIR> <WORKTREE_DIR> <BRANCH>\n' >&2
  exit 1
}
shift

# --- loop — 1 Issue の収束ループ -------------------------------------------
loop_main() {
  local RUN_DIR WORKTREE_DIR BRANCH
  RUN_DIR="${1:?usage: trinity loop <RUN_DIR> <WORKTREE_DIR> <BRANCH>}"
  WORKTREE_DIR="${2:?WORKTREE_DIR required}"
  BRANCH="${3:?BRANCH required}"
  export RUN_DIR WORKTREE_DIR BRANCH

  mkdir -p "${RUN_DIR}/ask"
  # shellcheck source=lib/actors.sh
  . "${TRINITY_ROOT}/lib/actors.sh"

  : "${TRINITY_MAX_LOOPS:=5}"

  # pid を原子的に主張する（O_EXCL）。既存かつ生存していれば多重起動として何もせず終わる。
  # 死んでいれば前回のクラッシュ跡（stale）として引き継ぎ、続きから再開する。
  if ! ( set -o noclobber; printf '%s\n' "$$" > "${RUN_DIR}/pid" ) 2>/dev/null; then
    local existing_pid
    existing_pid="$(cat "${RUN_DIR}/pid" 2>/dev/null || true)"
    if [ -n "${existing_pid}" ] && kill -0 "${existing_pid}" 2>/dev/null; then
      trinity::log "既に実行中（pid ${existing_pid}）。何もせず終了する。"
      exit 0
    fi
    trinity::log "pid ${existing_pid} は死んでいる（stale）。引き継いで再開する。"
    printf '%s\n' "$$" > "${RUN_DIR}/pid"
  fi

  # 設計分岐の確認: plan.md の `## 要確認の論点` を ask/q に出し、回答（ask/a）を待つ。
  # 人間の確認に締切は設けない（回答が来るまで安価に待つ）。
  loop::ask() {
    local loop="$1"
    awk '/^## 要確認の論点/{p=1;print;next} p&&/^## /{p=0} p' \
      "${RUN_DIR}/plan.md" > "${RUN_DIR}/ask/q"
    rm -f "${RUN_DIR}/ask/a"
    trinity::status needs-input
    trinity::log "ループ ${loop}: 確認待ち（ask/q を Orchestrator が拾う）"
    while [ ! -f "${RUN_DIR}/ask/a" ]; do sleep 5; done
    { printf '\n## 確定事項（ループ %s で確認済み）\n' "${loop}"; cat "${RUN_DIR}/ask/a"; } \
      >> "${RUN_DIR}/requirement.md"
    rm -f "${RUN_DIR}/ask/q" "${RUN_DIR}/ask/a"
  }

  # RUN_DIR の既存成果物から再開ループ番号とモードを返す。
  # 出力形式: "<n> <mode>"（例: "2 plan"）。PASS 済みのときは "PASS" のみ。
  # 各段は自己スキップするため入口判定は不要。
  # redrive マーカーが残っている（＝再収束が未完）ときは PASS 短絡を行わず、
  # 最大 eval 番号 + 1 を常に plan モードで返す（修正要望による再収束）。
  loop::resume_point() {
    local k=0 k_verdict="" num="" verdict="" f
    for f in "${RUN_DIR}"/eval-*.md; do
      [ -f "$f" ] || continue
      num="${f##*/eval-}"
      num="${num%.md}"
      case "${num}" in *[!0-9]*) continue ;; esac
      verdict="$(trinity::verdict_of "$f")"
      case "${verdict}" in
        PASS | NEEDS_REVISION | FAIL) ;;
        *) continue ;;
      esac
      if [ "${num}" -gt "${k}" ]; then k="${num}"; k_verdict="${verdict}"; fi
    done

    if [ -f "${RUN_DIR}/redrive" ]; then
      printf '%s plan\n' "$((k + 1))"; return
    fi

    if [ "${k}" -eq 0 ]; then
      printf '1 plan\n'; return
    fi
    [ "${k_verdict}" = PASS ] && { printf 'PASS\n'; return; }

    local n mode
    n=$((k + 1))
    case "${k_verdict}" in
      NEEDS_REVISION) mode=plan ;;
      *)              mode=revise ;;
    esac
    printf '%s %s\n' "${n}" "${mode}"
  }

  trinity::log "loop 開始: ${BRANCH}"

  # redrive マーカーがあれば修正要望を requirement.md へ取り込む。マーカー自体は
  # 消さない。再収束が完了する（新しい PASS または終端 failed に達する）までの
  # 耐久状態として残し、途中でクラッシュして再起動しても未完のまま続きから拾える
  # ようにする。取り込み済みかどうかは requirement.md の内容そのもので判断し、
  # 再開のたびに同じ文が重複追記されないようにする。
  if [ -f "${RUN_DIR}/redrive" ]; then
    local redrive_body req_content
    redrive_body="$(cat "${RUN_DIR}/redrive")"
    req_content="$(cat "${RUN_DIR}/requirement.md" 2>/dev/null || true)"
    if [[ "${req_content}" != *"${redrive_body}"* ]]; then
      { printf '\n## 修正要望（re-drive）\n'; printf '%s\n' "${redrive_body}"; } >> "${RUN_DIR}/requirement.md"
      trinity::log "re-drive 信号を検出した。requirement.md に取り込み、最大 eval 番号 + 1 から plan で再収束する"
    fi
  fi

  local resume loop mode rc
  resume="$(loop::resume_point)"
  if [ "${resume}" = PASS ]; then
    trinity::log "再開判定: 既に PASS 済み。再実行しない。"
    trinity::status passed
    exit 0
  fi
  read -r loop mode <<< "${resume}"
  [ "${loop}" -gt 1 ] && trinity::log "再開: ループ ${loop} から ${mode} で再開する"

  # re-drive は新しい収束試行なので、開始ループから TRINITY_MAX_LOOPS 回ぶんの予算を
  # 相対的に与える（通常の crash-resume は従来どおり絶対上限のまま）。redrive マーカーは
  # 再収束が完了するまで残るため、この判定は再起動のたびにディスクから読み直され、
  # 拡張予算はクラッシュ後の再開でも失われない。
  local max_loop="${TRINITY_MAX_LOOPS}"
  [ -f "${RUN_DIR}/redrive" ] && max_loop=$((loop + TRINITY_MAX_LOOPS - 1))

  while [ "${loop}" -le "${max_loop}" ]; do
    if [ "${mode}" = plan ]; then
      rc=0
      trinity::plan "${loop}" || rc=$?
      if [ "${rc}" -eq "${TRINITY_RC_NEEDS_INPUT}" ]; then
        loop::ask "${loop}"
        continue
      fi
      [ "${rc}" -ne 0 ] && exit 1
      trinity::generate "${loop}"
    else
      trinity::revise "${loop}"
    fi

    trinity::tools "${loop}"

    rc=0
    trinity::evaluate "${loop}" || rc=$?
    case "${rc}" in
      0) trinity::log "ループ ${loop} で PASS。PR 作成へ。"; rm -f "${RUN_DIR}/redrive"; exit 0 ;;
      2) mode=plan ;;    # NEEDS_REVISION → 再計画
      3) mode=revise ;;  # FAIL → 既存計画の範囲内で修正
      *) exit 1 ;;
    esac
    loop=$((loop + 1))
  done

  rm -f "${RUN_DIR}/redrive"
  trinity::status failed
  trinity::log "ループ ${max_loop} まで回したが PASS に到達しなかった"
  exit 2
}

# --- ディスパッチ -------------------------------------------------------------
loop_main "$@"
